<?xml version="1.0" encoding="utf-8"?>
<!-- .specs/2026-10-13_ping-pong-imitation-learning.md -->
<SNN model="$(PLASTICITY_MODEL)">
  <RECEPTORS name="Punishment" n="1">
    <Implementation lib="ping-pong-environment"></Implementation>
  </RECEPTORS>
  <RECEPTORS name="Reward" n="1">
    <Implementation lib="ping-pong-environment"></Implementation>
  </RECEPTORS>
  <RECEPTORS name="R" n="108">
    <Implementation lib="ping-pong-environment">
      <args>
        <after_reward_silence>0</after_reward_silence>
      </args>
    </Implementation>
  </RECEPTORS>
  <RECEPTORS name="Actions" n="2">
    <Implementation lib="ping-pong-environment">
      <args>
        <action_period>$(ACTION_PERIOD)</action_period>
        <learning_time>$(LEARNING_TIME)</learning_time>
        <racket_size>0.18</racket_size>
        <racket_step>0.0333333</racket_step>
        <movement_threshold>0.0166667</movement_threshold>
      </args>
    </Implementation>
  </RECEPTORS>
  <NETWORK ncopies="$(NNETWORKCOPIES)" merge="yes">
    <Sections>
      <Section name="L">
        <props>
          <n>$(NLEARNERS)</n>
          <Structure type="L">
            <dim>$(NLEARNINGGROUPS)</dim>
            <dim>$(NTARGETCLASSES)</dim>
          </Structure>
          <chartime>5</chartime>
          <stochastic_stimulation>$(STOCHASTICSTIMULATION)</stochastic_stimulation>
          <hebbian_plasticity>-$(DWNEG)</hebbian_plasticity>
          <dopamine_plasticity_time>$(DOPAMINE_PLASTICITY_TIME)</dopamine_plasticity_time>
          <maxTSSISI>$(MAX_TSS_ISI)</maxTSSISI>
          <stability_resource_change_ratio>$(STABILITYRESOURCECHANGERATIO)</stability_resource_change_ratio>
          <minweight>-$(MINWEIGHT)</minweight>
          <maxweight>$(MAXWEIGHT)</maxweight>
          <nsilentsynapses>$(NSILENTSYNAPSES)</nsilentsynapses>
          <threshold_excess_weight_dependent>$(WTHREXCESS)</threshold_excess_weight_dependent>
<!--ONE_FACTOR_PLASTICITY-->
          <_1_factor_plasticity>-$(ONE_FACTOR_PLASTICITY)</_1_factor_plasticity>
          <_1_factor_plasticity_period>10</_1_factor_plasticity_period>
<!--/ONE_FACTOR_PLASTICITY-->
<!--LINEARIZED_PLASTICITY-->
          <b>$(B)</b>
          <hinge_position>$(HINGE_POSITION)</hinge_position>
<!--/LINEARIZED_PLASTICITY-->
        </props>
      </Section>
      <Section name="$(OUTPUT)">
        <props>
          <n>$(NTARGETCLASSES)</n>
        </props>
      </Section>
      <Section name="BIASGATE">
        <props>
          <n>$(NTARGETCLASSES)</n>
        </props>
      </Section>
      <Link from="$(INPUT)" to="L" type="signal">
        <iniresource>$(INIRESOURCE0)</iniresource>
        <delay>$(INPUT_DELAY)</delay>
        <probability>$(SPARSITY)</probability>
      </Link>
      <Link from="L" to="L" policy="all-to-all-sections" type="gating">
        <weight>-10</weight>
      </Link>
      <Link from="$(REWARD)" to="L" policy="aligned" type="reward">
        <weight>$(DWPOS)</weight>
        <delay>3</delay>
      </Link>
      <Link from="L" to="$(OUTPUT)" policy="aligned"></Link>
      <Link from="$(OUTPUT)" to="BIASGATE" policy="aligned" type="gating">
        <weight>-10</weight>
      </Link>
      <Link from="BIASGATE" to="$(OUTPUT)" policy="aligned" type="gating">
        <weight>-3</weight>
      </Link>
      <Link from="$(REWARD)" to="BIASGATE" policy="aligned"></Link>
      <Link from="BIASGATE" to="L" policy="aligned"></Link>
<!--MUTUAL_SUPPRESSION-->
      <Link from="$(OUTPUT)" to="$(OUTPUT)" policy="all-to-all" type="gating">
        <weight>-$(ACTION_PERIOD)</weight>
      </Link>
<!--/MUTUAL_SUPPRESSION-->
    </Sections>
  </NETWORK>
  <Readout lib="ping-pong-environment">
    <output>$(OUTPUT)</output>
    <args>
      <start_time>$(LEARNING_TIME)</start_time>
      <agent_start_time>$(AGENT_START)</agent_start_time>
      <fitness>f1</fitness>
      <log_period>200000</log_period>
      <window>2000</window>
      <racket_jitter>$(RACKET_JITTER)</racket_jitter>
      <jitter_every>$(JITTER_EVERY)</jitter_every>
      <report_file>imitation_report.txt</report_file>
    </args>
  </Readout>
</SNN>
